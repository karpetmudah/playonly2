# SaaS Multi-Tenant Configuration
# Copy this file to .env and configure your values

# Application Mode
OPENHANDS_CONFIG_CLS=openhands.server.config.saas_server_config.SaaSServerConfig

# MongoDB Configuration
MONGODB_URL=mongodb://localhost:27017
# For MongoDB Atlas: mongodb+srv://username:password@cluster.mongodb.net/

# JWT Authentication
JWT_SECRET_KEY=your-super-secret-jwt-key-change-this-in-production

# Credit System Configuration
TOKENS_PER_DOLLAR=1000
DEFAULT_CREDITS=10.0

# User Storage Configuration
USER_STORE_CLASS=openhands.storage.user.mongodb_user_store.MongoDBUserStore

# Workspace Configuration
MAX_WORKSPACE_SIZE_GB=5

# LLM Configuration (users can override these)
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=your-openai-api-key

# Optional: Redis for session management (recommended for production)
# REDIS_HOST=localhost
# REDIS_PASSWORD=your-redis-password

# Optional: File storage (for production)
# FILE_STORE=s3
# FILE_STORE_PATH=s3://your-bucket-name
# AWS_ACCESS_KEY_ID=your-aws-access-key
# AWS_SECRET_ACCESS_KEY=your-aws-secret-key

# Optional: Monitoring
# POSTHOG_CLIENT_KEY=your-posthog-key

# Security
ENABLE_BILLING=true
HIDE_LLM_SETTINGS=false
